    %temp5 = freeze %Internal.Unit zeroinitializer
    %temp6 = load %S, ptr %prm1
    %temp9 = getelementptr %S, ptr %prm1, i32 0, i32 3
    %temp8 = load [2 x i32], ptr %temp9
    %temp12 = getelementptr [2 x i32], ptr %temp9, i32 0, i32 1
    %temp11 = load i32, ptr %temp12
    store i32 77, ptr %temp12
    %temp13 = freeze %Internal.Unit zeroinitializer
    %temp14 = load %S, ptr %prm1
    ret %S %temp14
}

define %Internal.Unit @rx_source_main(){
