%S = type{ i1, i32, i1, [2 x i32] }

define %S @CloneS(ptr %temp1)
{
entry:
    %temp2 = alloca %S
    %temp4 = getelementptr %S, ptr %temp1, i32 0, i32 0
    %temp5 = load i1, ptr %temp4
    %temp6 = getelementptr %S, ptr %temp2, i32 0, i32 0
    store i1 %temp5, ptr %temp6
    %temp7 = getelementptr %S, ptr %temp1, i32 0, i32 1
    %temp8 = load i32, ptr %temp7
    %temp9 = getelementptr %S, ptr %temp2, i32 0, i32 1
    store i32 %temp8, ptr %temp9
    %temp10 = getelementptr %S, ptr %temp1, i32 0, i32 2
    %temp11 = load i1, ptr %temp10
    %temp12 = getelementptr %S, ptr %temp2, i32 0, i32 2
    store i1 %temp11, ptr %temp12
    %temp13 = getelementptr %S, ptr %temp1, i32 0, i32 3
    %temp14 = load [2 x i32], ptr %temp13
    %temp15 = getelementptr %S, ptr %temp2, i32 0, i32 3
    %temp16 = alloca i32
    store i32 0, ptr %temp16
    br label %block1
block1:
    %temp20 = load i32, ptr %temp16
    %temp17 = getelementptr [2 x i32], ptr %temp13, i32 0, i32 %temp20
    %temp18 = load i32, ptr %temp17
    %temp19 = getelementptr [2 x i32], ptr %temp15, i32 0, i32 %temp20
    store i32 %temp18, ptr %temp19
    %temp21 = add i32 %temp20, 1
    store i32 %temp21, ptr %temp16
    %temp22 = icmp ne i32 %temp21, 2
    br i1 %temp22, label %block1,label %block2
block2:
    %temp3 = load %S, ptr %temp2
    ret %S %temp3
}

define i1 @EqualS(ptr %temp2, ptr %temp3){
entry:
    %temp1 = alloca i1
    store i1 true, ptr %temp1    %temp5 = getelementptr %S, ptr %temp2, i32 0, i32 0
    %temp7 = load i1, ptr %temp5
    %temp6 = getelementptr %S, ptr %temp3, i32 0, i32 0
    %temp8 = load i1, ptr %temp6
    %temp9 = icmp eq i1 %temp7, %temp8
    br i1 %temp9, label %block3, label %block1
block3:
    %temp10 = getelementptr %S, ptr %temp2, i32 0, i32 1
    %temp12 = load i32, ptr %temp10
    %temp11 = getelementptr %S, ptr %temp3, i32 0, i32 1
    %temp13 = load i32, ptr %temp11
    %temp14 = icmp eq i32 %temp12, %temp13
    br i1 %temp14, label %block4, label %block1
block4:
    %temp15 = getelementptr %S, ptr %temp2, i32 0, i32 2
    %temp17 = load i1, ptr %temp15
    %temp16 = getelementptr %S, ptr %temp3, i32 0, i32 2
    %temp18 = load i1, ptr %temp16
    %temp19 = icmp eq i1 %temp17, %temp18
    br i1 %temp19, label %block5, label %block1
block5:
    %temp20 = getelementptr %S, ptr %temp2, i32 0, i32 3
    %temp22 = load [2 x i32], ptr %temp20
    %temp21 = getelementptr %S, ptr %temp3, i32 0, i32 3
    %temp23 = load [2 x i32], ptr %temp21
    %temp25 = alloca i32
    store i32 0, ptr %temp25
    %temp30 = alloca i1
    store i1 true, ptr %temp30
    br label %block6
block6:
    %temp31 = load i32, ptr %temp25
    %temp26 = getelementptr [2 x i32], ptr %temp20, i32 0, i32 %temp31
    %temp28 = load i32, ptr %temp26
    %temp27 = getelementptr [2 x i32], ptr %temp21, i32 0, i32 %temp31
    %temp29 = load i32, ptr %temp27
    %temp34 = icmp eq i32 %temp28, %temp29
    %temp32 = add i32 %temp31, 1
    store i32 %temp32, ptr %temp25
    br i1 %temp34, label %block7, label %block8
block7:
    %temp33 = icmp ne i32 %temp32, 2
    br i1 %temp33, label %block6,label %block9
block8:
    store i1 false, ptr %temp30
    br label %block9
block9:
    %temp24 = load i1, ptr %temp30
    br i1 %temp24, label %block2, label %block1
block1:
    store i1 false, ptr %temp1
    br label %block2
block2:
    %temp4 = load i1, ptr %temp1
    ret i1 %temp4
}

define i32 @func1(i32 %param1){
entry:
    %prm1 = alloca i32
    store i32 %param1, ptr %prm1
    %temp1 = load i32, ptr %prm1
    call void @println_i32( i32 %temp1 )
    %temp2 = freeze %Internal.Unit zeroinitializer
    %temp3 = load i32, ptr %prm1
    ret i32 %temp3
}

define %S @func2(%S %param1){
entry:
    %prm1 = alloca %S
    store %S %param1, ptr %prm1
    %temp1 = load %S, ptr %prm1
    %temp4 = getelementptr %S, ptr %prm1, i32 0, i32 1
