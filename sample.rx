use rx::core::*;

#[derive(Clone, Copy)]
struct Packet {
    data: [i32; 8],
    flag: bool,
}
#[derive(Clone, Copy)]
struct View<'a> {
    data: &'a [i32; 8],
    tag: i32,
}
fn edit(mut p: Packet, tail: i32) -> Packet {
    p.data[7] += tail;
    p.flag = !p.flag;
    p
}
fn make(x: i32) -> Packet {
    Packet {
        data: [x; 8],
        flag: true,
    }
}
fn f(a: &i32, b: &i32) -> i32 {
    a + b
}
fn main() {
    println_i32(1);
}
